{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>christfriedbalizou/renovate"],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: [
    "prIgnoreNotification",
    "prEditedNotification",
  ],
  mise: {
    enabled: false,
  },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^scripts\\/install-vim\\.sh$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+\"(?<currentValue>[^\"|\\s]+)\\|(?<currentDigest>[a-f0-9]{40})\\|https://github\\.com/[^\"\\s]+\\.git\"",
      ],
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^scripts\\/install-vim\\.sh$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>git-refs) packageName=(?<packageName>\\S+) currentValue=(?<currentValue>\\S+)\\s+(?:\\w+=)?\"[^\"|]+\\|(?<currentDigest>[a-f0-9]{40})\\|https://github\\.com/[^\"\\s]+\\.git\"",
      ],
    },
  ],
  packageRules: [
    {
      description: "Keep supported OS matrix releases explicitly curated",
      matchDatasources: ["docker"],
      matchPackageNames: ["debian", "ubuntu"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "Automerge non-major dependency updates",
      matchUpdateTypes: [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest",
        "lockFileMaintenance",
      ],
      automerge: true,
      automergeType: "pr",
      platformAutomerge: true,
    },
    {
      description: "Keep major dependency updates manual",
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      description: "Group tagged Vim plugin updates together",
      matchManagers: ["custom.regex"],
      matchDatasources: ["github-tags"],
      matchFileNames: ["scripts/install-vim.sh"],
      groupName: "vim plugin tags",
      labels: [
        "renovate/vim",
        "area/vim",
      ],
    },
    {
      description: "Group branch-pinned Vim plugin digest updates together",
      matchManagers: ["custom.regex"],
      matchDatasources: ["git-refs"],
      matchFileNames: ["scripts/install-vim.sh"],
      groupName: "vim plugin branch pins",
      labels: [
        "renovate/vim",
        "area/vim",
        "type/digest",
      ],
    },
    {
      description: "Label GitHub Actions updates",
      matchManagers: ["github-actions"],
      labels: [
        "renovate/github-action",
        "area/github",
      ],
    },
    {
      description: "Label major updates",
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      description: "Label minor updates",
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      description: "Label patch, digest, pin, and lock file updates",
      matchUpdateTypes: [
        "patch",
        "digest",
        "pin",
        "lockFileMaintenance",
      ],
      addLabels: ["type/patch"],
    },
  ],
  lockFileMaintenance: {
    enabled: true,
  },
}
